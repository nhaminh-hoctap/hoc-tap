+    case 'sound':setSetting('sound',b.dataset.v==='1');render();break;
+    case 'auto':setSetting('autoRead',b.dataset.v==='1');render();break;
+    case 'reset':modal={kind:'reset'};renderModal();break;
+    case 'reset-ok':resetAll();modal=null;render();break;
+  }
+});
+/* kéo – thả cho dạng bài phân loại */
+let drag=null;
+document.addEventListener('pointerdown',e=>{const c=e.target.closest('[data-drag]');if(!c||!round||round.state.answered)return;drag={el:c,id:+c.dataset.drag,x:e.clientX,y:e.clientY,moved:false,ghost:null,over:null};});
+document.addEventListener('pointermove',e=>{if(!drag)return;const dx=e.clientX-drag.x,dy=e.clientY-drag.y;
+  if(!drag.moved&&Math.hypot(dx,dy)>10){drag.moved=true;const g=drag.el.cloneNode(true);g.classList.add('ghost');g.removeAttribute('data-drag');document.body.appendChild(g);drag.ghost=g;drag.el.classList.add('dragging');}
+  if(drag.moved){e.preventDefault();drag.ghost.style.left=e.clientX+'px';drag.ghost.style.top=e.clientY+'px';const t=document.elementFromPoint(e.clientX,e.clientY);const bin=t&&t.closest('[data-bin]');if(drag.over&&drag.over!==bin)drag.over.classList.remove('over');if(bin)bin.classList.add('over');drag.over=bin;}},{passive:false});
+function endDrag(e,cancel){if(!drag)return;const d=drag;drag=null;
+  if(d.moved){d.ghost.remove();d.el.classList.remove('dragging');if(d.over)d.over.classList.remove('over');if(!cancel){const t=document.elementFromPoint(e.clientX,e.clientY);const bin=t&&t.closest('[data-bin]');if(bin){placeItem(d.id,+bin.dataset.bin);return;}}render();}
+  else if(!cancel){const st=round.state;if(st.placed[d.id]!==undefined){delete st.placed[d.id];st.isel=d.id;}else st.isel=st.isel===d.id?null:d.id;render();}}
+document.addEventListener('pointerup',e=>endDrag(e,false));
+document.addEventListener('pointercancel',e=>endDrag(e,true));
+document.addEventListener('submit',e=>{if(e.target.dataset.form==='gate'){e.preventDefault();gateCheck();}});
+document.addEventListener('keydown',e=>{
+  if(modal){if(e.key==='Escape'){modal=null;renderModal();}return;}
+  if(view.name==='drill'&&drill&&!drill.done){if(/^[0-9]$/.test(e.key)){dKey(e.key);e.preventDefault();}else if(e.key==='Backspace'){dKey('del');e.preventDefault();}else if(e.key==='Enter'){dKey('ok');e.preventDefault();}return;}
+  if(view.name!=='quiz'||!round)return;const st=round.state,q=curQ();
+  if(st.answered){if(e.key==='Enter'){e.preventDefault();if(round.test){if(round.i<round.qs.length-1)tGo(round.i+1);else go({name:'tresult'});}else nextQ();}return;}
+  if(q.type==='number'){if(/^[0-9]$/.test(e.key)){keyIn(e.key);e.preventDefault();}else if((e.key===','||e.key==='.')&&q.dec){keyIn(',');e.preventDefault();}else if(e.key==='Backspace'){keyIn('del');e.preventDefault();}else if(e.key==='Enter'){keyIn('ok');e.preventDefault();}}
+  const bin=e.target.closest&&e.target.closest('[data-bin]');if(bin&&(e.key==='Enter'||e.key===' ')&&st.isel!==null){e.preventDefault();placeItem(st.isel,+bin.dataset.bin);}
+});
+document.getElementById('scenery').innerHTML=SCENERY;document.getElementById('clouds').innerHTML=CLOUDS;
+if(window.PORTAL&&PORTAL.app){document.body.classList.add(PORTAL.parent?'portal-parent':'portal-kid');}
+if(window.PORTAL&&PORTAL.parent){view={name:'parent'};}
+render();
+
+</script>
+</body>
+</html>
