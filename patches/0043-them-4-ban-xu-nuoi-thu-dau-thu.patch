+  return Q_choice({prompt:`Vì sao từ <b>“${C[1]}”</b> trong câu sau được viết hoa?<br><i>${C[0]}</i>`,options:['Thể hiện sự tôn trọng đặc biệt','Vì đứng đầu câu','Vì là tên địa lí'],answer:0,explain:'Danh từ chung dùng để chỉ người được kính trọng đặc biệt (như Bác Hồ) được viết hoa để thể hiện sự tôn trọng.',key:'cr'+C[1]});}
+const FOR5=['Lép Tôn-xtôi','Mát-xcơ-va','An-đéc-xen','Ê-đi-xơn','Xa-ha-ra','Ma-ri Quy-ri','Ô-xtrây-li-a','Pa-ri'];
+function t5_foreign(){const t=rnd(0,1);if(t===0){const f=pick(FOR5);const w=uniq([f.toLowerCase(),f.replace(/-/g,' '),f.split(' ').map(w=>w.split('-').map(x=>x.charAt(0).toUpperCase()+x.slice(1)).join('-')).join(' '),f.replace(/-/g,'')]).filter(x=>x!==f).slice(0,3);
+  return Q_choice({prompt:'Tên riêng nước ngoài nào viết <b>đúng</b>?',correct:f,wrong:w,explain:`Viết đúng: <b>${f}</b>. Viết hoa chữ cái đầu mỗi bộ phận; giữa các tiếng trong một bộ phận có gạch nối.`,key:'fo0'+f});}
+  const N=pick([['Bắc Kinh','Trung Quốc'],['Luân Đôn','Anh'],['Nhật Bản','châu Á']]);return Q_choice({prompt:`Tên riêng <b>“${N[0]}”</b> được viết theo cách nào?`,options:['Đọc theo âm Hán Việt, viết như tên riêng Việt Nam','Phiên âm, có dấu gạch nối'],answer:0,explain:`Tên “${N[0]}” đọc theo âm Hán Việt nên viết hoa như tên riêng Việt Nam.`,key:'fo1'+N[0]});}
+/* --- bài đọc soạn mới theo chủ điểm --- */
+Object.assign(STORIES,{
+ m1:{theme:'Thế giới tuổi thơ',title:'Mùa diều',text:'Chiều hè, gió từ cánh đồng thổi lồng lộng. Lũ trẻ chúng tôi rủ nhau ra bãi đê thả diều. Cánh diều giấy của tôi do ông nội làm, khung tre vót mỏng, dán giấy màu đỏ thắm.\nDiều lên cao dần, cao dần, rồi chao nghiêng giữa trời xanh. Sáo diều vi vu như tiếng hát của gió. Tôi nằm ngửa trên thảm cỏ, mắt dõi theo cánh diều mà thấy lòng mình cũng như bay lên.\nBây giờ đã lớn, mỗi lần nghe tiếng sáo diều, tôi lại nhớ ông, nhớ những buổi chiều tuổi thơ êm đềm ấy.',qs:[['Lũ trẻ thả diều ở đâu?','Trên bãi đê',['Trong sân trường','Trên sân thượng']],['Ai đã làm cánh diều cho bạn nhỏ?','Ông nội',['Bố','Anh trai']],['Tiếng sáo diều được so sánh với gì?','Tiếng hát của gió',['Tiếng chim hót','Tiếng suối chảy']],['Khi lớn lên, nghe tiếng sáo diều, tác giả nhớ điều gì?','Nhớ ông và những buổi chiều tuổi thơ',['Nhớ bài học ở trường','Nhớ những cơn mưa']]]},
+ m2:{theme:'Thế giới tuổi thơ',title:'Chiếc hộp kỉ niệm',text:'Cuối năm lớp Năm, cô giáo đề nghị mỗi bạn viết một lá thư gửi chính mình của mười năm sau. Cả lớp bỏ thư vào một chiếc hộp gỗ rồi chôn dưới gốc cây phượng.\nTrong thư, tôi viết về ước mơ trở thành kĩ sư xây cầu, về người bạn thân ngồi cùng bàn và về chú chó nhỏ ở nhà. Tôi tự hỏi mười năm nữa mình sẽ như thế nào.\nCô giáo dặn: “Hãy sống sao cho đến ngày mở hộp, các em không thấy tiếc những ngày hôm nay.”',qs:[['Cô giáo đề nghị học sinh làm gì?','Viết thư gửi chính mình mười năm sau',['Viết thư gửi bố mẹ','Vẽ tranh về trường']],['Chiếc hộp được chôn ở đâu?','Dưới gốc cây phượng',['Trong lớp học','Ở sân bóng']],['Bạn nhỏ mơ ước trở thành gì?','Kĩ sư xây cầu',['Bác sĩ','Phi công']],['Lời dặn của cô giáo khuyên điều gì?','Sống trân trọng từng ngày hôm nay',['Quên đi quá khứ','Chỉ nghĩ đến tương lai']]]},
+ m3:{theme:'Thiên nhiên kì thú',title:'Ruộng bậc thang mùa nước đổ',text:'Tháng Năm, những thửa ruộng bậc thang ở vùng cao bắt đầu vào mùa nước đổ. Nước từ khe suối được dẫn về, tràn qua từng bậc ruộng. Dưới nắng sớm, các thửa ruộng như những tấm gương khổng lồ xếp chồng lên nhau, lấp lánh từ chân núi lên tận lưng trời.\nNgười dân bản cần mẫn cày bừa, gieo mạ. Tiếng trâu nghé ọ vang vọng khắp thung lũng. Chẳng bao lâu nữa, cả sườn đồi sẽ khoác lên mình tấm áo xanh mướt của lúa non.',qs:[['Mùa nước đổ diễn ra vào tháng nào?','Tháng Năm',['Tháng Chạp','Tháng Tám']],['Các thửa ruộng được so sánh với gì?','Những tấm gương khổng lồ',['Những dải lụa','Những bậc cầu thang gỗ']],['Nước được dẫn về ruộng từ đâu?','Từ khe suối',['Từ giếng khoan','Từ biển']],['Bài đọc chủ yếu tả gì?','Cảnh ruộng bậc thang mùa nước đổ',['Phiên chợ vùng cao','Lễ hội mùa xuân']]]},
+ m4:{theme:'Thiên nhiên kì thú',title:'Hang động kì vĩ',text:'Sâu trong núi đá vôi có một hang động lớn đến mức cả một khu rừng nhỏ mọc được bên trong. Ánh nắng chiếu qua những hố sụt trên vòm hang, nuôi những cây xanh cao vút. Có cả mây bay lơ lửng giữa lòng hang.\nCác nhà thám hiểm phải mang theo dây thừng, đèn pin và lều trại, đi bộ nhiều ngày mới tới được những khu vực sâu nhất. Họ dặn du khách: hãy chỉ để lại dấu chân và chỉ mang về những bức ảnh, để vẻ đẹp kì vĩ ấy còn mãi.',qs:[['Bên trong hang động có điều gì đặc biệt?','Có cả một khu rừng nhỏ và mây bay',['Có một thành phố','Có tuyết rơi']],['Vì sao cây xanh mọc được trong hang?','Nhờ ánh nắng chiếu qua các hố sụt',['Nhờ đèn điện','Nhờ người tưới nước']],['Các nhà thám hiểm mang theo những gì?','Dây thừng, đèn pin, lều trại',['Xe máy, ô tô','Thuyền buồm']],['Lời dặn du khách thể hiện điều gì?','Ý thức bảo vệ thiên nhiên',['Muốn hang đông người','Cấm chụp ảnh']]]},
+ m5:{theme:'Trên con đường học tập',title:'Cậu bé tự học',text:'Nhà Minh nghèo, không có tiền mua sách. Ngày ngày, cậu đến thư viện xã, mượn sách về đọc dưới ánh đèn dầu. Những cuốn sách cũ sờn gáy đưa cậu đến với những vùng đất xa xôi, những nhà khoa học tài ba.\nGặp bài toán khó, Minh kiên nhẫn làm đi làm lại, có khi đến khuya. Cậu ghi chép cẩn thận vào một cuốn sổ nhỏ những điều đã học được.\nNhiều năm sau, Minh trở thành thầy giáo. Thầy thường nói với học trò: “Sách là người thầy không bao giờ mệt mỏi.”',qs:[['Minh lấy sách ở đâu để đọc?','Mượn ở thư viện xã',['Mua ở hiệu sách','Bạn tặng']],['Khi gặp bài toán khó, Minh làm gì?','Kiên nhẫn làm đi làm lại',['Bỏ qua không làm','Nhờ bạn làm hộ']],['Sau này Minh trở thành ai?','Thầy giáo',['Bác sĩ','Nhà văn']],['Câu nói của thầy Minh ca ngợi điều gì?','Giá trị của sách',['Sức khỏe','Tiền bạc']]]},
+ m6:{theme:'Nghệ thuật muôn màu',title:'Bức tranh làng',text:'Ở làng em có một nghệ nhân làm tranh dân gian. Giấy làm tranh được quét lớp điệp óng ánh. Màu vẽ lấy từ cây lá quanh làng: màu vàng từ hoa hòe, màu đen từ than lá tre, màu đỏ từ sỏi son.\nNhững bức tranh vẽ đàn lợn ăn cây ráy, chú bé cưỡi trâu thổi sáo, hội vật ngày xuân… đều giản dị mà tươi vui. Mỗi dịp Tết, người dân lại mua tranh về treo, như mang cả mùa xuân vào nhà.',qs:[['Màu vàng trong tranh được lấy từ đâu?','Hoa hòe',['Than lá tre','Sỏi son']],['Tranh thường vẽ về đề tài gì?','Cuộc sống làng quê giản dị',['Thành phố hiện đại','Tàu vũ trụ']],['Người dân mua tranh vào dịp nào?','Dịp Tết',['Mùa hè','Ngày khai giảng']],['Câu “như mang cả mùa xuân vào nhà” dùng biện pháp gì?','So sánh',['Điệp từ','Liệt kê']]]},
+ m7:{theme:'Vẻ đẹp cuộc sống',title:'Hạt gạo quê em',text:'Để có hạt gạo trắng thơm, người nông dân phải trải qua bao vất vả. Tháng sáu nắng như đổ lửa, mẹ vẫn lội ruộng cấy lúa. Những ngày mưa bão, bố thức trắng đêm be bờ giữ nước.\nĐến mùa gặt, cánh đồng vàng óng. Tiếng cười nói rộn ràng trên những bờ ruộng. Mỗi bát cơm ăn hằng ngày đều chứa đựng mồ hôi và tình yêu của người làm ra hạt gạo.',qs:[['Tháng sáu, mẹ làm gì trên đồng?','Lội ruộng cấy lúa',['Gặt lúa','Phơi thóc']],['Những ngày mưa bão, bố làm gì?','Thức trắng đêm be bờ giữ nước',['Ngủ sớm','Đi chợ']],['Mùa gặt, cánh đồng có màu gì?','Vàng óng',['Xanh non','Nâu đất']],['Bài đọc muốn nhắn nhủ điều gì?','Trân trọng công sức người làm ra hạt gạo',['Nên ăn ít cơm','Không cần làm ruộng']]]},
+ m8:{theme:'Hương sắc trăm miền',title:'Chợ nổi miền Tây',text:'Mới tờ mờ sáng, chợ nổi trên sông đã nhộn nhịp. Hàng trăm chiếc ghe, xuồng chở đầy dưa hấu, xoài, khóm, bí đỏ… neo san sát. Người bán treo hàng lên một cây sào cao gọi là “cây bẹo” để khách nhìn từ xa đã biết ghe bán gì.\nTiếng mời chào, tiếng máy nổ, tiếng cười nói hòa vào nhau. Ánh nắng ban mai rọi xuống mặt sông lấp loáng. Chợ nổi là nét văn hóa độc đáo của người dân vùng sông nước.',qs:[['Chợ nổi họp ở đâu?','Trên sông',['Trên núi','Trong phố']],['“Cây bẹo” dùng để làm gì?','Treo hàng để khách biết ghe bán gì',['Chèo thuyền','Phơi quần áo']],['Chợ nổi nhộn nhịp vào lúc nào?','Tờ mờ sáng',['Buổi tối','Giữa trưa']],['Chợ nổi là nét văn hóa của vùng nào?','Vùng sông nước miền Tây',['Vùng núi phía Bắc','Vùng biển đảo']]]},
+ m9:{theme:'Tiếp bước cha ông',title:'Người thầy thuốc của dân',text:'Ngày xưa có một vị danh y cả đời chữa bệnh cứu người. Ông đi khắp nơi tìm cây thuốc nam, ghi chép công dụng của từng loại lá, từng loại rễ. Ông nói: “Thuốc nam chữa bệnh cho người nam.”\nGặp người nghèo, ông không lấy tiền, còn cho thuốc mang về. Có lần, trời mưa gió, ông vẫn vượt sông đến chữa cho một em bé ốm nặng. Nhân dân kính trọng gọi ông là người thầy thuốc của dân.',qs:[['Vị danh y đi khắp nơi để làm gì?','Tìm cây thuốc nam',['Đi du lịch','Buôn bán']],['Gặp người nghèo, ông làm gì?','Không lấy tiền, còn cho thuốc',['Lấy tiền gấp đôi','Từ chối chữa']],['Ông vượt sông trong mưa gió để làm gì?','Chữa cho em bé ốm nặng',['Về thăm nhà','Đi chợ']],['Nhân dân gọi ông là gì?','Người thầy thuốc của dân',['Người giàu nhất làng','Ông quan']]]},
+ m10:{theme:'Thế giới của chúng ta',title:'Một giờ tắt đèn',text:'Mỗi năm, vào một buổi tối cuối tháng Ba, hàng triệu người trên thế giới cùng tắt đèn trong một giờ. Các tòa nhà cao tầng, những cây cầu nổi tiếng chìm vào bóng tối.\nMột giờ ấy không chỉ để tiết kiệm điện. Đó là lời nhắc mọi người cùng chung tay bảo vệ Trái Đất: tắt điện khi không dùng, trồng thêm cây xanh, hạn chế rác thải nhựa. Những việc nhỏ của mỗi người sẽ góp thành thay đổi lớn.',qs:[['Hoạt động tắt đèn diễn ra vào thời gian nào?','Một buổi tối cuối tháng Ba',['Sáng mùng một Tết','Ngày khai giảng']],['Mọi người tắt đèn trong bao lâu?','Một giờ',['Một ngày','Một tuần']],['Mục đích của hoạt động là gì?','Nhắc mọi người chung tay bảo vệ Trái Đất',['Để xem pháo hoa','Để ngủ sớm']],['Câu cuối bài nêu ý gì?','Việc nhỏ của mỗi người góp thành thay đổi lớn',['Chỉ người lớn mới bảo vệ được Trái Đất','Tiết kiệm điện là không cần thiết']]]}});
