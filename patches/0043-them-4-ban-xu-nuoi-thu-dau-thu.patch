+ v1:{theme:'Bầu trời tuổi thơ',title:'Con đò tuổi thơ',text:'Hồi nhỏ, mỗi chiều hè tôi lại theo ông ra bến sông. Ông là người chở đò. Con đò nhỏ chòng chành trên mặt nước, chở người qua sông đi chợ, đi làm đồng.\nÔng ít nói nhưng hiền hậu. Có lần một bà cụ không có tiền đò, ông vẫn chở bà qua sông và còn dặn: “Bà cứ đi, khi nào có thì gửi sau.” Bà cụ cảm động mãi.\nBây giờ bến đò đã có cây cầu bắc ngang. Nhưng mỗi khi đi qua cầu, tôi vẫn nhìn xuống dòng sông, như thấy bóng ông và con đò nhỏ năm nào.',qs:[['Ông của nhân vật “tôi” làm nghề gì?','Chở đò',['Đánh cá','Làm ruộng']],['Chi tiết ông chở bà cụ không có tiền đò cho thấy ông là người thế nào?','Hiền hậu, tốt bụng',['Nghiêm khắc','Keo kiệt']],['Văn bản được kể theo ngôi thứ mấy?','Ngôi thứ nhất',['Ngôi thứ hai','Ngôi thứ ba']],['Đề tài của văn bản là gì?','Kỉ niệm tuổi thơ',['Chiến tranh','Khoa học viễn tưởng']]]},
+ v2:{theme:'Cội nguồn yêu thương',title:'Bàn tay của mẹ',text:'Mẹ tôi có đôi bàn tay gầy, các ngón tay chai sạn vì bao năm làm lụng. Đôi bàn tay ấy đã cấy những thửa ruộng xanh, đã khâu những chiếc áo cho tôi mặc tới trường.\nMùa đông năm ấy, tôi ốm nặng. Suốt đêm, bàn tay mẹ đặt lên trán tôi, mát lạnh mà ấm áp lạ lùng. Tôi thiếp đi trong vòng tay ấy.\nGiờ đây tôi đã lớn, đã đi xa. Mỗi lần nhớ nhà, tôi lại nhớ đôi bàn tay của mẹ – đôi bàn tay chứa cả một trời thương yêu.',qs:[['Các ngón tay của mẹ có đặc điểm gì?','Chai sạn vì làm lụng',['Mềm mại, trắng trẻo','Đeo nhiều nhẫn']],['Khi “tôi” ốm, mẹ đã làm gì?','Đặt tay lên trán con suốt đêm',['Đi làm đồng','Gọi bác sĩ rồi đi ngủ']],['Từ “chai sạn” là từ loại gì?','Tính từ',['Danh từ','Số từ']],['Tình cảm chủ đạo của văn bản là gì?','Lòng biết ơn, yêu thương mẹ',['Nỗi sợ hãi','Sự giận dỗi']]]},
+ v3:{theme:'Bài học cuộc sống',title:'Con cáo và chùm nho',text:'Một con cáo đói đi qua vườn nho. Nó thấy những chùm nho chín mọng treo lủng lẳng trên giàn cao. Cáo nhảy lên, nhảy mãi mà không với tới.\nCuối cùng, cáo mệt quá, bỏ đi và lẩm bẩm: “Nho còn xanh lắm, chẳng ngon lành gì!”\nCâu chuyện nhắc chúng ta: khi không đạt được điều mình muốn, đừng chê bai để che giấu sự bất lực của bản thân.',qs:[['Vì sao cáo không ăn được nho?','Giàn nho quá cao, cáo không với tới',['Nho chưa chín','Bác chủ vườn đuổi đi']],['Cáo nói gì khi bỏ đi?','Nho còn xanh lắm',['Nho ngon quá','Mai mình sẽ quay lại']],['Văn bản thuộc thể loại nào?','Truyện ngụ ngôn',['Truyện khoa học viễn tưởng','Tùy bút']],['Bài học rút ra là gì?','Đừng chê bai để che giấu sự bất lực của mình',['Nên ăn nhiều nho','Cáo là loài thông minh nhất']]]},
+ v4:{theme:'Thế giới viễn tưởng',title:'Chuyến đi đến sao Hỏa',text:'Năm 2090, tàu Bình Minh hạ cánh xuống sao Hỏa. Lan, cô bé mười hai tuổi, là hành khách nhỏ tuổi nhất. Qua ô cửa kính, em thấy mặt đất đỏ rực, những ngọn núi lửa khổng lồ đã ngủ yên hàng triệu năm.\nCác nhà khoa học dựng nhà kính để trồng rau. Lan được giao chăm sóc luống cải đầu tiên trên hành tinh đỏ. Khi những chiếc lá xanh đầu tiên nhú lên, cả đoàn reo hò…\nTối đó, Lan nhìn về phía một chấm sáng xanh nhỏ xíu trên bầu trời – Trái Đất, quê hương của em.',qs:[['Câu chuyện diễn ra vào năm nào?','2090',['1990','2020']],['Lan được giao nhiệm vụ gì?','Chăm sóc luống cải đầu tiên',['Lái tàu vũ trụ','Đo nhiệt độ núi lửa']],['Dấu chấm lửng trong câu “cả đoàn reo hò…” có tác dụng gì?','Gợi niềm vui còn kéo dài, chưa nói hết',['Liệt kê sự vật','Thể hiện lời nói ngập ngừng']],['Văn bản thuộc thể loại nào?','Truyện khoa học viễn tưởng',['Truyện ngụ ngôn','Văn bản tường trình']]]},
+ v5:{theme:'Trải nghiệm để trưởng thành',title:'Thất bại là người thầy',text:'Nhiều người sợ thất bại. Nhưng thất bại không đáng sợ, nó là người thầy nghiêm khắc giúp ta trưởng thành.\nKhi thất bại, ta biết mình còn thiếu sót ở đâu để sửa chữa. Nhà bác học Ê-đi-xơn đã thử hàng nghìn lần mới làm ra bóng đèn điện. Ông nói rằng mình không thất bại, chỉ là tìm ra những cách chưa đúng.\nVì vậy, mỗi chúng ta hãy dũng cảm đối mặt với thất bại, coi đó là bài học để bước tiếp.',qs:[['Ý kiến chính của văn bản là gì?','Thất bại là người thầy giúp ta trưởng thành',['Không nên thử việc mới','Thất bại rất đáng sợ']],['Câu chuyện về Ê-đi-xơn đóng vai trò gì?','Là bằng chứng',['Là lí lẽ','Là kết luận']],['Văn bản thuộc kiểu văn bản nào?','Văn bản nghị luận',['Văn bản tự sự','Văn bản tường trình']],['Từ “Vì vậy” trong đoạn cuối là phương tiện liên kết nào?','Phép nối',['Phép lặp','Phép thế']]]},
+ v6:{theme:'Hòa điệu với tự nhiên',title:'Rùa biển trở về',text:'Mỗi năm, từ tháng 6 đến tháng 10, rùa biển lại bơi hàng nghìn ki-lô-mét để trở về bãi biển nơi chúng chào đời và đẻ trứng. Một con rùa mẹ có thể đẻ khoảng 100 quả trứng trong một lần.\nSau khoảng 50–60 ngày, rùa con nở và bò ra biển. Tuy nhiên, chỉ khoảng 1 trong 1 000 rùa con sống được đến khi trưởng thành¹.\nĐể bảo vệ rùa biển, các khu bảo tồn đã tổ chức tuần tra, di dời trứng đến nơi an toàn và kêu gọi du khách không xả rác nhựa xuống biển.\n¹ Theo số liệu của các tổ chức bảo tồn biển.',qs:[['Rùa biển trở về đẻ trứng vào thời gian nào?','Từ tháng 6 đến tháng 10',['Từ tháng 1 đến tháng 3','Quanh năm']],['Mỗi lần, một con rùa mẹ đẻ khoảng bao nhiêu trứng?','Khoảng 100 quả',['Khoảng 10 quả','Khoảng 1 000 quả']],['Chú thích ở cuối văn bản (¹) gọi là gì?','Cước chú',['Nhan đề','Sa pô']],['Văn bản thuộc loại nào?','Văn bản thông tin',['Truyện ngụ ngôn','Thơ năm chữ']]]}});
