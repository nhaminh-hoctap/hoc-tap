+ s21:{theme:'Con người Việt Nam',title:'Chú lao công',text:'Khi cả phố còn đang ngủ say, chú Ba lao công đã thức dậy. Chú mặc bộ quần áo màu cam, cầm chổi quét từng góc phố. Những chiếc lá khô, những mẩu giấy vụn được chú gom lại, cho vào xe rác.\nTrời sáng dần. Mọi người ra đường thấy con phố sạch bong. Bé Tí đi học qua, lễ phép chào: “Cháu chào chú ạ! Cảm ơn chú đã làm phố mình sạch đẹp!” Chú Ba mỉm cười thật hiền.',
+  qs:[['Chú Ba làm nghề gì?','Lao công',['Bác sĩ','Bộ đội']],['Chú Ba bắt đầu làm việc khi nào?','Khi cả phố còn đang ngủ say',['Khi trời đã trưa','Khi mọi người đi làm về']],['Chú mặc quần áo màu gì?','Màu cam',['Màu xanh','Màu trắng']],['Nhờ chú Ba, con phố thế nào?','Sạch bong',['Ồn ào','Đông vui']],['Bé Tí nói gì với chú Ba?','Lời chào và lời cảm ơn',['Lời xin lỗi','Lời mời đi chơi']],['Từ nào chỉ hoạt động của chú Ba?','quét',['sạch bong','màu cam']]]},
+ s22:{theme:'Việt Nam quê hương em',title:'Hồ Gươm',text:'Hồ Gươm nằm giữa lòng Thủ đô Hà Nội. Mặt hồ xanh biếc như một chiếc gương lớn. Giữa hồ có Tháp Rùa cổ kính, xung quanh là những hàng liễu rủ bóng xuống mặt nước.\nCầu Thê Húc sơn màu đỏ, cong cong như con tôm, dẫn vào đền Ngọc Sơn. Sáng sớm, nhiều người ra bờ hồ tập thể dục. Các bạn nhỏ thích nhất là được ngắm hồ vào những ngày cuối tuần.',
+  qs:[['Hồ Gươm ở đâu?','Thủ đô Hà Nội',['Thành phố Huế','Thành phố Đà Nẵng']],['Mặt hồ được so sánh với gì?','Một chiếc gương lớn',['Một tấm thảm','Một dải lụa']],['Giữa hồ có gì?','Tháp Rùa',['Cầu Thê Húc','Đền Ngọc Sơn']],['Cầu Thê Húc sơn màu gì?','Màu đỏ',['Màu vàng','Màu xanh']],['Sáng sớm, nhiều người ra bờ hồ làm gì?','Tập thể dục',['Bơi thuyền','Câu cá']],['Tên riêng nào viết đúng?','Thê Húc',['thê Húc','Thê húc']]]}});
+/* ================= DANH MỤC THEO SGK TOÁN 7 ================= */
+/* ================= TOÁN 7 (SGK Kết nối tri thức) ================= */
+const vn=x=>{const neg=x<0;x=Math.abs(+(+x).toFixed(6));let [i,d]=String(x).split('.');i=i.replace(/\B(?=(\d{3})+(?!\d))/g,' ');return (neg?'−':'')+i+(d?','+d:'');};
+const r2=x=>Math.round(x*1e6)/1e6;
+const gcd=(a,b)=>b?gcd(b,a%b):Math.abs(a);
+const FR=(a,b)=>`<span class="frac"><span>${a}</span><span class="fd">${b}</span></span>`;
+function fr(n,d){if(d<0){n=-n;d=-d;}const g=gcd(Math.abs(n),d)||1;return [n/g,d/g];}
+const frT=(n,d)=>{[n,d]=fr(n,d);return d===1?vn(n):(n<0?'−':'')+Math.abs(n)+'/'+d;};
+const frH=(n,d)=>{[n,d]=fr(n,d);return d===1?vn(n):(n<0?'−':'')+FR(Math.abs(n),d);};
+const sgn=x=>x<0?`(${vn(x)})`:vn(x);
+function Qn(o){if(typeof o.answer==='number'&&!Number.isInteger(o.answer))o.dec=true;if(o.answer<0)o.neg=true;return Q_number(o);}
+function frChoice(prompt,n,d,ex,key){const right=frT(n,d);const [a,b]=fr(n,d);const W=uniq([frT(-a,b),frT(a+1,b),frT(a,b+1),frT(b,a||1),frT(a-1,b)]).filter(x=>x!==right);
+  return Q_choice({prompt,correct:right,wrong:sample(W,3),layout:'sym',explain:ex+` Kết quả: <b>${frH(n,d)}</b>.`,key});}
+const rq=()=>{const d=pick([2,3,4,5,6,8,10]);let n=rnd(-9,9);if(!n)n=1;return [n,d];};
+/* --- Chương I. Số hữu tỉ --- */
+function g7_qset(){const t=rnd(0,2);
+  if(t===0){const [n,d]=rq();const [a,b]=fr(n,d);return Q_choice({prompt:`Số đối của ${frH(a,b)} là:`,correct:frT(-a,b),wrong:uniq([frT(a,b),frT(b,a),frT(-b,a)]).filter(x=>x!==frT(-a,b)),layout:'sym',explain:`Số đối của a là −a: số đối của ${frH(a,b)} là <b>${frH(-a,b)}</b>.`,key:'qs0'+a+b});}
+  if(t===1){let [n1,d1]=rq(),[n2,d2]=rq();if(n1*d2===n2*d1)n2++;const s=n1*d2>n2*d1?'>':'<';return Q_choice({prompt:`Chọn dấu thích hợp:<br><span class="cmp">${frH(n1,d1)} <span class="blank">?</span> ${frH(n2,d2)}</span>`,options:['>','<','='],answer:['>','<','='].indexOf(s),layout:'sym',explain:`Quy đồng mẫu số dương: ${frH(n1*d2,d1*d2)} và ${frH(n2*d1,d1*d2)}; so sánh tử số: ${n1*d2} ${s} ${n2*d1}.`,key:'qs1'+n1+d1+n2+d2});}
+  const S=pick([['−0,5','ℚ (số hữu tỉ)'],['3/4','ℚ (số hữu tỉ)'],['−7','ℤ (số nguyên) và ℚ'],['√2','không thuộc ℚ (số vô tỉ)']]);
+  return Q_choice({prompt:`Số <b>${S[0]}</b> thuộc tập hợp nào?`,options:['ℚ (số hữu tỉ)','ℤ (số nguyên) và ℚ','không thuộc ℚ (số vô tỉ)'],answer:['ℚ (số hữu tỉ)','ℤ (số nguyên) và ℚ','không thuộc ℚ (số vô tỉ)'].indexOf(S[1]),explain:'Số hữu tỉ viết được dưới dạng a/b (a, b nguyên, b ≠ 0). Số nguyên cũng là số hữu tỉ. √2 không viết được dưới dạng phân số.',key:'qs2'+S[0]});}
+function g7_qcalc(){const [a,b]=rq(),[c,d]=rq(),op=pick(['+','−','×',':']);let n,m;
+  if(op==='+'){n=a*d+c*b;m=b*d;}else if(op==='−'){n=a*d-c*b;m=b*d;}else if(op==='×'){n=a*c;m=b*d;}else{n=a*d;m=b*c;}
+  return frChoice(`Tính: ${frH(a,b)} ${op} ${c<0&&op!=='×'&&op!==':'?'('+frH(c,d)+')':c<0?'('+frH(c,d)+')':frH(c,d)} = ?`,n,m,op==='+'||op==='−'?'Quy đồng mẫu số rồi cộng (trừ) các tử số.':op==='×'?'Nhân tử với tử, mẫu với mẫu (chú ý dấu).':'Nhân với số nghịch đảo của số chia.','qc'+a+b+op+c+d);}
+function g7_qdec(){const a=r2(rnd(-90,90)/10),b=r2(rnd(-90,90)/10),op=pick(['+','−']);const r=r2(op==='+'?a+b:a-b);
+  return Qn({prompt:`Tính: <b>${vn(a)} ${op} ${sgn(b)} = ?</b>`,answer:r,explain:`${vn(a)} ${op} ${sgn(b)} = <b>${vn(r)}</b>. Nhớ quy tắc dấu: trừ một số là cộng với số đối của nó.`,key:'qd'+a+op+b});}
+function g7_pow(){const t=rnd(0,2);
+  if(t===0){const b=pick([-3,-2,2,3,5,-5]),e=rnd(2,4);if(Math.abs(b)===5&&e>3)return g7_pow();return Qn({prompt:`Tính: <b>${sgn(b)}<sup>${e}</sup> = ?</b>`,answer:b**e,explain:`${sgn(b)}<sup>${e}</sup> = ${Array(e).fill(sgn(b)).join(' · ')} = <b>${vn(b**e)}</b>. Lũy thừa bậc chẵn của số âm là số dương, bậc lẻ là số âm.`,key:'pw0'+b+e});}
+  if(t===1){const b=rnd(2,7),m=rnd(2,6),n=rnd(2,6),div=Math.random()<0.5;return Q_number({prompt:div?`Viết kết quả dưới dạng lũy thừa: ${b}<sup>${m+n}</sup> : ${b}<sup>${n}</sup> = ${b}<sup>?</sup>`:`Viết kết quả dưới dạng lũy thừa: ${b}<sup>${m}</sup> · ${b}<sup>${n}</sup> = ${b}<sup>?</sup>`,answer:div?m:m+n,explain:div?`Chia hai lũy thừa cùng cơ số: trừ số mũ (${m+n} − ${n} = ${m}).`:`Nhân hai lũy thừa cùng cơ số: cộng số mũ (${m} + ${n} = ${m+n}).`,key:'pw1'+b+m+n+div});}
+  const b=rnd(2,5),m=rnd(2,4),n=rnd(2,3);return Q_number({prompt:`(${b}<sup>${m}</sup>)<sup>${n}</sup> = ${b}<sup>?</sup>`,answer:m*n,explain:`Lũy thừa của lũy thừa: nhân số mũ (${m} · ${n} = ${m*n}).`,key:'pw2'+b+m+n});}
+function g7_order(){const a=rnd(-9,9),b=rnd(2,5),c=rnd(-6,6),d=rnd(2,3),t=rnd(0,2);let e,r,ex;
+  if(t===0){e=`${sgn(a)} + ${b} · ${sgn(c)}`;r=a+b*c;ex=`Nhân trước: ${b} · ${sgn(c)} = ${vn(b*c)}; rồi cộng: ${vn(a)} + ${sgn(b*c)} = <b>${vn(r)}</b>.`;}
+  else if(t===1){e=`(${vn(a)} − ${sgn(c)}) · ${b}`;r=(a-c)*b;ex=`Trong ngoặc trước: ${vn(a)} − ${sgn(c)} = ${vn(a-c)}; rồi nhân ${b}: <b>${vn(r)}</b>.`;}
+  else{e=`${b}<sup>${d}</sup> − ${sgn(a)} · 2`;r=b**d-2*a;ex=`Lũy thừa trước: ${b}<sup>${d}</sup> = ${b**d}; nhân: ${sgn(a)} · 2 = ${vn(2*a)}; trừ: <b>${vn(r)}</b>.`;}
+  return Qn({prompt:`Tính giá trị biểu thức: <b>${e}</b>`,answer:r,explain:ex+' Thứ tự: ngoặc → lũy thừa → nhân, chia → cộng, trừ.',key:'or'+e});}
+function g7_transpose(){const a=rnd(-15,15),b=rnd(-15,15),t=rnd(0,1);
+  if(t===0)return Qn({prompt:`Tìm x, biết: <b>x + ${sgn(a)} = ${vn(b)}</b>`,answer:b-a,explain:`Chuyển vế đổi dấu: x = ${vn(b)} − ${sgn(a)} = <b>${vn(b-a)}</b>.`,key:'tr0'+a+b});
+  const k=pick([2,3,4,5,-2,-3]),x=rnd(-9,9);return Qn({prompt:`Tìm x, biết: <b>${k}x − ${sgn(a)} = ${vn(k*x-a)}</b>`,answer:x,explain:`${k}x = ${vn(k*x-a)} + ${sgn(a)} = ${vn(k*x)}; x = ${vn(k*x)} : ${sgn(k)} = <b>${vn(x)}</b>.`,key:'tr1'+k+x+a});}
+/* --- Chương II. Số thực --- */
+function g7_repeat(){const P=pick([[1,3,'0,(3)','3'],[2,3,'0,(6)','6'],[1,9,'0,(1)','1'],[5,11,'0,(45)','45'],[1,6,'0,1(6)','6'],[7,9,'0,(7)','7'],[4,11,'0,(36)','36'],[1,7,'0,(142857)','142857']]);const t=rnd(0,1);
+  if(t===0)return Q_choice({prompt:`Viết ${FR(P[0],P[1])} dưới dạng số thập phân:`,correct:P[2],wrong:uniq(['0,'+P[3],'0,('+P[3]+'0)',(P[0]/P[1]).toFixed(2).replace('.',',')]).filter(x=>x!==P[2]),layout:'sym',explain:`${P[0]} : ${P[1]} = ${P[2]} — số thập phân vô hạn tuần hoàn, chu kì <b>${P[3]}</b>.`,key:'rp0'+P[0]+P[1]});
+  return Q_choice({prompt:`Chu kì của số thập phân <b>${P[2]}</b> là:`,correct:P[3],wrong:uniq(['0',P[3]+'0',P[3].slice(0,1)+'1','3']).filter(x=>x!==P[3]).slice(0,3),layout:'sym',explain:`Phần trong ngoặc là chu kì: <b>${P[3]}</b>.`,key:'rp1'+P[2]});}
+function g7_sqrt(){const t=rnd(0,2);if(t===0){const a=rnd(1,15);return Q_number({prompt:`Tính: <b>√${a*a} = ?</b>`,answer:a,explain:`Vì ${a}² = ${a*a} và ${a} ≥ 0 nên √${a*a} = <b>${a}</b>.`,key:'sq0'+a});}
+  if(t===1){const n=rnd(2,99);const v=Math.sqrt(n);if(Number.isInteger(v))return g7_sqrt();const r=Math.round(v*100)/100;return Qn({prompt:`Dùng máy tính, tính √${n} rồi làm tròn đến hàng phần trăm:`,answer:r,explain:`√${n} ≈ ${vn(+v.toFixed(5))}… ≈ <b>${vn(r)}</b>.`,key:'sq1'+n});}
+  const S=pick([['√9','hữu tỉ'],['√5','vô tỉ'],['π','vô tỉ'],['0,(3)','hữu tỉ'],['√16','hữu tỉ'],['√7','vô tỉ']]);return Q_choice({prompt:`Số <b>${S[0]}</b> là số hữu tỉ hay số vô tỉ?`,options:['Số hữu tỉ','Số vô tỉ'],answer:S[1]==='hữu tỉ'?0:1,layout:'sym',explain:S[1]==='hữu tỉ'?'Viết được dưới dạng phân số (hoặc số thập phân hữu hạn, vô hạn tuần hoàn).':'Là số thập phân vô hạn không tuần hoàn.',key:'sq2'+S[0]});}
+function g7_abs(){const t=rnd(0,1);if(t===0){const a=r2(rnd(-99,99)/(Math.random()<0.5?1:10));return Qn({prompt:`Tính: <b>|${vn(a)}| = ?</b>`,answer:Math.abs(a),explain:`Giá trị tuyệt đối là khoảng cách từ điểm đó đến 0 trên trục số, luôn không âm: <b>${vn(Math.abs(a))}</b>.`,key:'ab0'+a});}
+  const a=rnd(1,12);return Q_choice({prompt:`Tìm x, biết |x| = ${a}.`,correct:`x = ${a} hoặc x = −${a}`,wrong:[`x = ${a}`,`x = −${a}`,'Không có x'],explain:`Có hai số cách 0 một khoảng ${a}: <b>${a}</b> và <b>−${a}</b>.`,key:'ab1'+a});}
+function g7_roundR(){const x=r2(rnd(100,99999)/1000),p=pick([[1,'hàng phần mười'],[2,'hàng phần trăm'],[0,'hàng đơn vị']]);const r=r2(Math.round(x*10**p[0])/10**p[0]);
+  return Qn({prompt:`Làm tròn số <b>${vn(x)}</b> đến ${p[1]}:`,answer:r,explain:`Kết quả: <b>${vn(r)}</b>.`,key:'rr'+x+p[0]});}
+/* --- Chương III. Góc, đường thẳng song song --- */
+function g7_angle(){const a=rnd(20,160),t=rnd(0,2);
+  if(t===0)return Q_number({prompt:`Hai góc kề bù, một góc bằng <b>${a}°</b>. Góc còn lại bằng bao nhiêu độ?`,answer:180-a,unit:'°',explain:`Hai góc kề bù có tổng 180°: 180° − ${a}° = <b>${180-a}°</b>.`,key:'an0'+a});
+  if(t===1)return Q_number({prompt:`Hai đường thẳng cắt nhau tạo thành một góc <b>${a}°</b>. Góc đối đỉnh với nó bằng bao nhiêu độ?`,answer:a,unit:'°',explain:'Hai góc đối đỉnh thì bằng nhau.',key:'an1'+a});
+  const b=rnd(10,89)*2;return Q_number({prompt:`Tia Oz là tia phân giác của góc xOy = <b>${b}°</b>. Góc xOz bằng bao nhiêu độ?`,answer:b/2,unit:'°',explain:`Tia phân giác chia góc thành hai góc bằng nhau: ${b}° : 2 = <b>${b/2}°</b>.`,key:'an2'+b});}
