+ k16:{theme:'Những sắc màu thiên nhiên',title:'Hàng phượng trước cổng trường',text:'Trước cổng trường em có một hàng phượng già. Mùa xuân, phượng ra lá non xanh mướt. Sang hè, hoa phượng nở đỏ rực như những ngọn lửa nhỏ thắp sáng cả góc trời.\nTrên cành, tiếng ve kêu râm ran. Chúng em nhặt những cánh phượng rơi, ép vào trang vở làm kỉ niệm.\nMỗi lần nhìn hàng phượng, em lại nhớ đến những ngày hè vui vẻ và những người bạn thân yêu.',
+  qs:[['Hàng phượng ở đâu?','Trước cổng trường',['Trong công viên','Bên bờ sông']],['Hoa phượng được so sánh với gì?','Những ngọn lửa nhỏ',['Những ngôi sao','Những chiếc ô']],['Các bạn nhỏ làm gì với cánh phượng rơi?','Ép vào trang vở làm kỉ niệm',['Đem bán','Vứt vào thùng rác']],['Hoa phượng nở vào mùa nào?','Mùa hè',['Mùa đông','Mùa thu']]]},
+ k17:{theme:'Những sắc màu thiên nhiên',title:'Đàn voi bên suối',text:'Giữa rừng già có một con suối trong vắt. Mỗi buổi chiều, đàn voi lại kéo nhau xuống suối uống nước. Voi mẹ đi trước, voi con lũn cũn theo sau.\nVoi con dùng vòi hút nước rồi phun lên lưng mẹ. Nước bắn tung tóe, lấp lánh trong nắng chiều. Voi mẹ khẽ vẫy tai như cười.\nKhi mặt trời khuất sau đỉnh núi, đàn voi lại thong thả trở về rừng sâu.',
+  qs:[['Đàn voi xuống suối vào lúc nào?','Mỗi buổi chiều',['Mỗi sáng sớm','Lúc nửa đêm']],['Voi con làm gì ở suối?','Hút nước phun lên lưng mẹ',['Bơi sang bờ bên kia','Ngủ dưới gốc cây']],['Từ nào tả dáng đi của voi con?','lũn cũn',['thong thả','lấp lánh']],['Bộ phận “giữa rừng già” trả lời câu hỏi nào?','Ở đâu?',['Khi nào?','Để làm gì?']]]},
+ k18:{theme:'Bài học từ cuộc sống',title:'Chiếc bình hoa vỡ',text:'Đang chơi bóng trong nhà, Tuấn lỡ làm vỡ chiếc bình hoa của mẹ. Cậu sợ quá, vội nhặt mảnh vỡ giấu đi. Tối đó, mẹ hỏi: “Ai làm vỡ bình hoa?” Tuấn im lặng.\nĐêm ấy, Tuấn trằn trọc mãi không ngủ được. Sáng hôm sau, cậu đến bên mẹ, lí nhí: “Mẹ ơi, con làm vỡ bình. Con xin lỗi mẹ.”\nMẹ ôm Tuấn: “Mẹ không giận vì chiếc bình. Mẹ vui vì con đã dám nói thật.”',
+  qs:[['Tuấn làm vỡ bình hoa khi nào?','Khi đang chơi bóng trong nhà',['Khi đang lau nhà','Khi đang ngủ']],['Vì sao Tuấn trằn trọc không ngủ được?','Vì cậu chưa nói thật với mẹ',['Vì trời nóng','Vì cậu đói bụng']],['Mẹ vui vì điều gì?','Tuấn đã dám nói thật',['Tuấn mua bình mới','Tuấn dọn nhà sạch']],['Câu chuyện khuyên em điều gì?','Phải trung thực, biết nhận lỗi',['Nên giấu lỗi đi','Không nên chơi bóng']]]},
+ k19:{theme:'Bài học từ cuộc sống',title:'Kiến con và hạt gạo',text:'Kiến con tìm được một hạt gạo to. Nó cố khiêng về tổ nhưng hạt gạo nặng quá. Kiến con thở hổn hển, định bỏ cuộc.\nMột bạn kiến đi qua, thấy vậy liền gọi thêm các bạn tới. Cả đàn kiến xúm lại, người đẩy, người kéo. Chẳng mấy chốc, hạt gạo đã nằm gọn trong tổ.\nKiến con hiểu rằng: việc khó đến đâu, có bạn bè cùng làm thì cũng xong.',
+  qs:[['Kiến con tìm được gì?','Một hạt gạo to',['Một chiếc lá','Một giọt mật']],['Vì sao kiến con định bỏ cuộc?','Vì hạt gạo nặng quá',['Vì trời mưa','Vì kiến con buồn ngủ']],['Các bạn kiến đã làm gì?','Cùng đẩy, kéo hạt gạo về tổ',['Ăn mất hạt gạo','Bỏ đi chỗ khác']],['Câu chuyện muốn nói điều gì?','Đoàn kết thì việc khó cũng xong',['Nên làm việc một mình','Không nên giúp bạn']]]},
+ k20:{theme:'Bài học từ cuộc sống',title:'Gọi điện cho bà',text:'Bà nội ở quê xa. Chủ nhật nào, Mai cũng gọi điện cho bà. Mai chào: “A lô, cháu Mai đây ạ! Bà có khỏe không ạ?”\nBà cười hiền: “Bà khỏe. Cháu học hành thế nào?” Mai kể cho bà nghe chuyện ở lớp, chuyện con mèo mới đẻ ba chú mèo con. Bà dặn Mai ngoan, nghe lời bố mẹ.\nTrước khi tắt máy, Mai nói: “Cháu chào bà ạ. Cháu nhớ bà lắm!”',
+  qs:[['Mai gọi điện cho bà vào lúc nào?','Chủ nhật hằng tuần',['Mỗi sáng','Ngày Tết']],['Khi gọi điện, Mai mở đầu thế nào?','Chào và tự giới thiệu',['Hỏi ngay việc cần','Im lặng chờ bà nói']],['Mai kể cho bà nghe chuyện gì?','Chuyện ở lớp và đàn mèo con',['Chuyện đi du lịch','Chuyện xem phim']],['Câu “Cháu nhớ bà lắm!” là kiểu câu gì?','Câu cảm',['Câu hỏi','Câu khiến']]]},
+ k21:{theme:'Đất nước ngàn năm',title:'Vịnh Hạ Long',text:'Vịnh Hạ Long ở tỉnh Quảng Ninh là một cảnh đẹp nổi tiếng của nước ta. Trên mặt vịnh có hàng nghìn hòn đảo lớn nhỏ. Có hòn giống con gà chọi, có hòn như chiếc ấm trà khổng lồ.\nNước vịnh xanh biếc, phẳng lặng như mặt gương. Trong lòng các đảo có nhiều hang động lung linh. Mỗi năm, rất nhiều du khách trong nước và nước ngoài đến thăm Hạ Long.\nEm tự hào vì đất nước mình có những cảnh đẹp như thế.',
+  qs:[['Vịnh Hạ Long thuộc tỉnh nào?','Quảng Ninh',['Khánh Hòa','Lạng Sơn']],['Trên mặt vịnh có gì?','Hàng nghìn hòn đảo lớn nhỏ',['Nhiều tòa nhà cao','Những cánh đồng lúa']],['Nước vịnh được so sánh với gì?','Mặt gương',['Dải lụa','Bầu trời']],['Tên riêng nào phải viết hoa?','Hạ Long',['hòn đảo','hang động']]]},
+ k22:{theme:'Đất nước ngàn năm',title:'Cậu bé làng Gióng',text:'Ngày xưa, ở làng Gióng có một cậu bé lên ba mà chưa biết nói, biết cười. Khi giặc Ân kéo đến, nghe sứ giả nhà vua đi tìm người tài, cậu bé bỗng cất tiếng nói, xin vua làm cho ngựa sắt, roi sắt và áo giáp sắt.\nTừ hôm ấy, Gióng lớn nhanh như thổi. Bà con trong làng góp gạo nuôi cậu. Gióng vươn vai thành tráng sĩ, cưỡi ngựa sắt xông ra đánh tan giặc.\nThắng giặc, Gióng cùng ngựa bay về trời. Nhân dân lập đền thờ để nhớ ơn người anh hùng.',
+  qs:[['Lúc lên ba, cậu bé làng Gióng thế nào?','Chưa biết nói, biết cười',['Đã biết đọc sách','Rất hay hát']],['Gióng xin vua những gì?','Ngựa sắt, roi sắt, áo giáp sắt',['Thuyền và cung tên','Vàng bạc']],['Ai đã góp gạo nuôi Gióng?','Bà con trong làng',['Nhà vua','Giặc Ân']],['Nhân dân làm gì để nhớ ơn Gióng?','Lập đền thờ',['Viết thư gửi Gióng','Đúc tượng ngựa vàng']]]},
+ k23:{theme:'Đất nước ngàn năm',title:'Ngày hội đua thuyền',text:'Mùa xuân, làng em mở hội đua thuyền trên sông. Từ sáng sớm, hai bên bờ đã chật kín người. Những chiếc thuyền dài sơn màu rực rỡ, cờ bay phấp phới.\nTiếng trống vang lên “Tùng! Tùng!”. Các tay chèo đồng loạt khua mái chèo. Thuyền lướt nhanh như tên bắn. Người xem reo hò cổ vũ vang cả khúc sông.\nĐội thuyền làng em về nhất. Cả làng vui như Tết.',
+  qs:[['Hội đua thuyền diễn ra vào mùa nào?','Mùa xuân',['Mùa đông','Mùa thu']],['Thuyền lướt nhanh được so sánh với gì?','Tên bắn',['Con cá','Cơn gió']],['Người xem làm gì?','Reo hò cổ vũ',['Ngồi yên lặng','Ra về sớm']],['Bài đọc nói về loại lễ hội nào?','Lễ hội đua thuyền',['Lễ hội đánh vật','Lễ hội thả diều']]]},
+ k24:{theme:'Trái Đất của chúng mình',title:'Lá thư của dòng sông',text:'Các bạn nhỏ thân mến! Tớ là dòng sông chảy qua làng các bạn. Ngày xưa, nước tớ trong veo, đàn cá tung tăng bơi lội. Các bạn thường ra bờ sông thả thuyền giấy.\nNhưng bây giờ, người ta vứt rác, đổ nước thải xuống tớ. Nước tớ đục ngầu, đàn cá bỏ đi hết. Tớ buồn lắm!\nCác bạn ơi, hãy giúp tớ nhé: đừng vứt rác xuống sông, hãy nhắc mọi người cùng giữ gìn dòng nước sạch.',
+  qs:[['Ai là người viết lá thư?','Dòng sông',['Một bạn nhỏ','Đàn cá']],['Vì sao nước sông bị đục?','Người ta vứt rác, đổ nước thải xuống sông',['Vì trời mưa to','Vì đàn cá khuấy nước']],['Dòng sông nhờ các bạn nhỏ điều gì?','Không vứt rác, giữ dòng nước sạch',['Thả thật nhiều thuyền giấy','Bắt hết cá trên sông']],['Câu “Hãy giúp tớ nhé!” là kiểu câu gì?','Câu khiến',['Câu kể','Câu hỏi']]]},
+ k25:{theme:'Trái Đất của chúng mình',title:'Rô-bốt nhỏ nhà em',text:'Nhà em có một chú rô-bốt hút bụi tròn như chiếc đĩa. Mỗi sáng, bố bấm nút, chú rô-bốt lại chạy khắp nhà, hút sạch bụi bẩn dưới gầm giường, gầm bàn.\nGặp chân ghế, chú tự quay đầu đi hướng khác. Hết pin, chú tự tìm về đế để sạc. Em đặt tên cho chú là Bon.\nBố nói: “Rô-bốt giúp con người làm việc, nhưng con người phải học thật giỏi mới làm ra được rô-bốt.” Em ước sau này sẽ chế tạo được những chú rô-bốt thật thông minh.',
+  qs:[['Rô-bốt nhà em làm việc gì?','Hút bụi',['Nấu cơm','Tưới cây']],['Khi hết pin, rô-bốt làm gì?','Tự tìm về đế để sạc',['Đứng yên một chỗ','Kêu thật to']],['Bạn nhỏ đặt tên rô-bốt là gì?','Bon',['Bin','Tôm']],['Bạn nhỏ ước điều gì?','Chế tạo được rô-bốt thông minh',['Có thật nhiều đồ chơi','Không phải đi học']]]},
+ k26:{theme:'Trái Đất của chúng mình',title:'Ngôi nhà chung',text:'Trái Đất là ngôi nhà chung của mọi người, mọi loài. Ở đó có những cánh rừng xanh, những đại dương bao la và biết bao loài vật đáng yêu.\nTrẻ em ở Việt Nam, ở Nhật Bản hay ở Bra-xin đều cùng chung một mái nhà. Các bạn nói những thứ tiếng khác nhau nhưng đều yêu cây xanh, yêu hòa bình.\nĐể ngôi nhà chung luôn xanh, sạch, đẹp, mỗi chúng ta hãy làm những việc nhỏ: trồng cây, tiết kiệm nước, tắt điện khi không dùng.',
+  qs:[['Ngôi nhà chung của mọi người, mọi loài là gì?','Trái Đất',['Ngôi trường','Thành phố']],['Trẻ em các nước giống nhau ở điểm nào?','Đều yêu cây xanh, yêu hòa bình',['Nói cùng một thứ tiếng','Sống cùng một thành phố']],['Tên nước nào viết đúng?','Bra-xin',['bra-xin','Braxin']],['Em có thể làm gì để giữ ngôi nhà chung?','Trồng cây, tiết kiệm nước, tắt điện',['Vứt rác xuống sông','Chặt cây làm đồ chơi']]]}});
