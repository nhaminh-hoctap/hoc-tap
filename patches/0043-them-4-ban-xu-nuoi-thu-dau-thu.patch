+ s5:{theme:'Vẻ đẹp quanh em',title:'Mùa xuân về',text:'Mùa xuân đã về trên quê em. Những hạt mưa phùn bay lất phất, nhẹ như rắc bụi. Trên cành cây, các chồi non xanh biếc nhú lên.\nCây đào trước ngõ nở hoa hồng thắm. Đàn chim én chao lượn trên bầu trời. Ngoài đồng, những cây mạ non xanh mơn mởn.\nAi cũng tươi cười chào đón năm mới.',
+  qs:[['Mưa phùn mùa xuân được tả như thế nào?','Nhẹ như rắc bụi',['To như trút nước','Lạnh như băng']],['Cây đào trước ngõ thế nào?','Nở hoa hồng thắm',['Rụng hết lá','Có nhiều quả chín']],['Loài chim nào chao lượn trên bầu trời?','Chim én',['Chim sẻ','Chim cú']],['Từ ngữ nào tả màu của những cây mạ non?','xanh mơn mởn',['hồng thắm','lất phất']],['Mùa xuân, ngoài đồng có gì?','Những cây mạ non',['Lúa chín vàng','Những đống rơm']]]},
+ s6:{theme:'Hành tinh xanh của em',title:'Những chú ong chăm chỉ',text:'Ong là loài vật nhỏ bé nhưng rất chăm chỉ. Từ sáng sớm, những chú ong thợ đã bay đi tìm hoa. Chúng hút mật hoa rồi mang về tổ để làm ra mật ong.\nKhi bay từ bông hoa này sang bông hoa khác, ong còn giúp cây ra quả. Một tổ ong có rất nhiều ong, mỗi con làm một việc.\nNhờ biết chung sức làm việc, cả đàn ong luôn có đủ thức ăn.',
+  qs:[['Từ sáng sớm, ong thợ bay đi đâu?','Bay đi tìm hoa',['Bay đi tìm nước','Bay về tổ ngủ']],['Ong mang mật hoa về tổ để làm gì?','Để làm ra mật ong',['Để tặng bạn','Để trồng cây']],['Khi bay từ hoa này sang hoa khác, ong giúp cây điều gì?','Giúp cây ra quả',['Giúp cây cao hơn','Giúp cây có lá xanh']],['Nhờ đâu cả đàn ong luôn có đủ thức ăn?','Nhờ biết chung sức làm việc',['Nhờ có người cho ăn','Nhờ ngủ thật nhiều']],['Từ nào chỉ đặc điểm của loài ong?','chăm chỉ',['mật ong','bay']]]},
+ s7:{theme:'Giao tiếp và kết nối',title:'Gọi điện cho bà',text:'Bà nội của Na sống ở quê. Tối thứ Bảy nào, Na cũng gọi điện thoại cho bà. Na kể cho bà nghe chuyện ở lớp, chuyện em được cô khen vì viết chữ đẹp.\nBà dặn Na ăn ngoan, học giỏi và nhớ mặc áo ấm khi trời trở lạnh. Trước khi tắt máy, Na nói: “Cháu chào bà ạ! Cháu nhớ bà nhiều lắm!”\nBà cười hiền hậu. Na thấy bà như đang ở ngay bên cạnh mình.',
+  qs:[['Bà nội của Na sống ở đâu?','Ở quê',['Ở cùng nhà với Na','Ở gần trường của Na']],['Na gọi điện cho bà vào lúc nào?','Tối thứ Bảy',['Sáng Chủ nhật','Trưa thứ Hai']],['Na được cô khen vì điều gì?','Viết chữ đẹp',['Hát hay','Chạy nhanh']],['Trước khi tắt máy, Na nói gì với bà?','Lời chào và lời nói nhớ bà',['Lời xin lỗi bà','Lời cảm ơn cô giáo']],['Bà dặn Na điều gì?','Ăn ngoan, học giỏi, mặc áo ấm khi trời lạnh',['Đi ngủ thật sớm','Về quê chơi với bà']]]},
+ s8:{theme:'Con người Việt Nam',title:'Bác Tư bảo vệ',text:'Trường em có bác Tư bảo vệ. Sáng nào bác cũng đến trường sớm nhất để mở cổng. Bác quét sạch lá rụng trên sân và tưới nước cho những chậu hoa.\nGiờ tan học, bác đứng ở cổng trường, nhắc chúng em đi thành hàng, không chạy nhảy, xô đẩy. Bạn nào quên áo mưa, bác lại cho mượn.\nChúng em ai cũng quý bác Tư.',
+  qs:[['Sáng nào bác Tư cũng làm việc gì?','Đến trường sớm nhất để mở cổng',['Đánh trống vào lớp','Dạy học sinh hát']],['Bác Tư tưới nước cho cái gì?','Những chậu hoa',['Bãi cỏ','Vườn rau']],['Giờ tan học, bác nhắc các bạn điều gì?','Đi thành hàng, không xô đẩy',['Chạy thật nhanh ra cổng','Ở lại lớp học bài']],['Câu nào cho thấy các bạn yêu quý bác Tư?','Chúng em ai cũng quý bác Tư.',['Bác quét sạch lá rụng trên sân.','Bác lại cho mượn.']],['Từ nào chỉ hoạt động của bác Tư?','quét',['sạch','cổng trường']]]},
+ s9:{theme:'Việt Nam quê hương em',title:'Vịnh Hạ Long',text:'Vịnh Hạ Long ở tỉnh Quảng Ninh. Nơi đây có hàng nghìn hòn đảo lớn nhỏ nhô lên giữa biển xanh. Có hòn trông giống con gà, có hòn trông giống chiếc ấm.\nNhiều hòn đảo có hang động rất đẹp. Mỗi năm, rất nhiều khách du lịch trong nước và nước ngoài đến thăm vịnh.\nAi cũng khen Hạ Long là một kì quan thiên nhiên tuyệt đẹp của Việt Nam.',
+  qs:[['Vịnh Hạ Long ở tỉnh nào?','Quảng Ninh',['Khánh Hòa','Ninh Bình']],['Giữa biển xanh có những gì?','Hàng nghìn hòn đảo lớn nhỏ',['Những cánh đồng lúa','Những ngôi nhà cao tầng']],['Nhiều hòn đảo có gì đẹp?','Hang động',['Thác nước','Vườn hoa']],['Tên riêng nào viết đúng?','Quảng Ninh',['quảng Ninh','Quảng ninh']],['Mỗi năm, ai đến thăm vịnh Hạ Long?','Khách du lịch trong nước và nước ngoài',['Chỉ có học sinh','Chỉ có người đánh cá']]]}};
