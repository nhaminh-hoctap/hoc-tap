+  K(3, '<p>xⁿ = x · x · … · x (n thừa số). x<sup>m</sup> · x<sup>n</sup> = x<sup>m+n</sup>; x<sup>m</sup> : x<sup>n</sup> = x<sup>m−n</sup>; (x<sup>m</sup>)<sup>n</sup> = x<sup>m·n</sup>.</p>', '(−2)³ = −8; (−2)⁴ = 16', 'Lũy thừa bậc chẵn của số âm là số dương.');
+  K(4, '<p>Thứ tự: ngoặc → lũy thừa → nhân, chia → cộng, trừ. <b>Quy tắc chuyển vế</b>: chuyển một số hạng sang vế kia thì đổi dấu.</p>', 'x + 5 = 2 → x = 2 − 5 = −3', null);
+  K(5, '<p>Phân số tối giản có mẫu chứa ước nguyên tố khác 2 và 5 thì viết được dưới dạng số thập phân <b>vô hạn tuần hoàn</b>.</p>', '1/3 = 0,333… = 0,(3); chu kì 3', null);
+  K(6, '<p><b>Số vô tỉ</b> là số thập phân vô hạn không tuần hoàn (√2, π). <b>Căn bậc hai số học</b> của a ≥ 0 là số x ≥ 0 mà x² = a.</p>', '√49 = 7 vì 7² = 49 và 7 ≥ 0', null);
+  K(7, '<p>Số hữu tỉ và số vô tỉ gọi chung là <b>số thực</b> (ℝ). Giá trị tuyệt đối |x| là khoảng cách từ x đến 0 trên trục số.</p>', '|−3,5| = 3,5', null);
+  K(8, '<p>Hai góc <b>kề bù</b> có tổng 180°. Hai góc <b>đối đỉnh</b> thì bằng nhau. <b>Tia phân giác</b> chia góc thành hai góc bằng nhau.</p>', null, null);
+  K(9, '<p>Nếu một đường thẳng cắt hai đường thẳng tạo ra một cặp góc so le trong (hoặc đồng vị) bằng nhau thì hai đường thẳng đó song song.</p>', null, null);
+  K(10, '<p><b>Tiên đề Euclid</b>: qua một điểm ngoài một đường thẳng chỉ có một đường thẳng song song với nó. Một đường thẳng cắt hai đường thẳng song song thì: các góc so le trong bằng nhau, các góc đồng vị bằng nhau, hai góc trong cùng phía bù nhau.</p>', null, null);
+  K(11, '<p><b>Định lí</b> gồm giả thiết (GT – điều cho biết) và kết luận (KL – điều suy ra). Chứng minh là dùng lập luận để từ GT suy ra KL.</p>', null, null);
+  K(12, '<p>Tổng ba góc của một tam giác bằng <b>180°</b>. Trong tam giác vuông, hai góc nhọn phụ nhau.</p>', null, null);
+  K(13, '<p>Hai tam giác bằng nhau khi các cạnh và các góc tương ứng bằng nhau. Trường hợp <b>c.c.c</b>: ba cạnh tương ứng bằng nhau.</p>', null, null);
+  K(14, '<p>Trường hợp <b>c.g.c</b>: hai cạnh và góc xen giữa. Trường hợp <b>g.c.g</b>: một cạnh và hai góc kề.</p>', null, null);
+  K(15, '<p>Tam giác vuông bằng nhau: hai cạnh góc vuông; cạnh góc vuông và góc nhọn kề; <b>cạnh huyền – góc nhọn</b>; <b>cạnh huyền – cạnh góc vuông</b>.</p>', null, null);
+  K(16, '<p>Tam giác cân có hai cạnh bên bằng nhau, hai góc ở đáy bằng nhau. Đường trung trực của đoạn thẳng là đường vuông góc tại trung điểm; điểm trên trung trực cách đều hai đầu mút.</p>', null, null);
+  K(17, '<p>Dữ liệu gồm dữ liệu là số (số liệu) và không phải là số. Cần kiểm tra tính hợp lí của dữ liệu.</p>', null, null);
+  K(18, '<p>Biểu đồ hình quạt tròn biểu diễn tỉ lệ phần trăm các phần so với tổng thể (cả hình tròn là 100%).</p>', null, null);
+  K(19, '<p>Biểu đồ đoạn thẳng biểu diễn sự thay đổi của một đại lượng theo thời gian.</p>', null, null);
+  K(20, '<p><b>Tỉ lệ thức</b> là đẳng thức của hai tỉ số a/b = c/d. Tính chất: a · d = b · c.</p>', 'x/4 = 6/8 → x = 4 · 6 : 8 = 3', null);
+  K(21, '<p>a/b = c/d = (a + c)/(b + d) = (a − c)/(b − d) (các mẫu khác 0).</p>', 'x/2 = y/3, x + y = 20 → (x + y)/5 = 4 → x = 8, y = 12', null);
+  K(22, '<p>y tỉ lệ thuận với x: y = kx (k ≠ 0). Tỉ số hai giá trị tương ứng không đổi.</p>', null, null);
+  K(23, '<p>y tỉ lệ nghịch với x: x · y = a (a ≠ 0). Tích hai giá trị tương ứng không đổi.</p>', null, null);
+  K(24, '<p>Biểu thức đại số gồm số, chữ (biến) và các phép toán. Thay giá trị của biến để tính giá trị biểu thức.</p>', null, null);
+  K(25, '<p>Đa thức một biến: tổng các đơn thức cùng biến. <b>Bậc</b>: số mũ cao nhất; <b>hệ số cao nhất</b>; <b>hệ số tự do</b>. Nghiệm: giá trị của x làm đa thức bằng 0.</p>', null, null);
+  K(26, '<p>Cộng, trừ đa thức: thu gọn các hạng tử cùng bậc (chú ý đổi dấu khi bỏ ngoặc có dấu trừ phía trước).</p>', null, null);
+  K(27, '<p>Nhân đa thức: nhân mỗi hạng tử của đa thức này với từng hạng tử của đa thức kia rồi cộng lại.</p>', '(x + 2)(x − 3) = x² − 3x + 2x − 6 = x² − x − 6', null);
+  K(28, '<p>Chia đa thức cho đơn thức: chia từng hạng tử. x<sup>m</sup> : x<sup>n</sup> = x<sup>m−n</sup>.</p>', null, null);
+  K(29, '<p>Biến cố <b>chắc chắn</b> (luôn xảy ra), <b>không thể</b> (không bao giờ xảy ra), <b>ngẫu nhiên</b> (có thể xảy ra hoặc không).</p>', null, null);
+  K(30, '<p>Khi các kết quả đồng khả năng: xác suất = số kết quả thuận lợi : tổng số kết quả.</p>', 'Gieo xúc xắc, xác suất ra mặt chẵn: 3/6 = 1/2', null);
+  K(31, '<p>Trong một tam giác, góc đối diện với cạnh lớn hơn là góc lớn hơn và ngược lại.</p>', null, null);
