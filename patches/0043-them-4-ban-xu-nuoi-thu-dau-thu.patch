+ k3:{theme:'Những trải nghiệm thú vị',title:'Học bơi',text:'Lần đầu xuống bể bơi, Nam run run, tay bám chặt vào thành bể. Thầy giáo dạy bơi nhẹ nhàng: “Con thả lỏng người, hít một hơi thật sâu rồi úp mặt xuống nước nhé!”\nNam làm theo. Nước mát lạnh ôm lấy người cậu. Ngày thứ hai, Nam đã biết đạp chân. Ngày thứ năm, cậu bơi được một đoạn ngắn mà không cần phao.\nNam reo lên: “Con bơi được rồi!” Thầy giáo mỉm cười giơ ngón tay cái khen ngợi.',
+  qs:[['Lần đầu xuống bể, Nam thế nào?','Run run, bám chặt thành bể',['Nhảy ùm xuống nước','Bơi ngay ra giữa bể']],['Thầy giáo dặn Nam làm gì?','Thả lỏng người, hít sâu rồi úp mặt xuống nước',['Ngồi trên bờ xem các bạn bơi','Đeo thật nhiều phao']],['Đến ngày thứ mấy Nam bơi được không cần phao?','Ngày thứ năm',['Ngày thứ hai','Ngày thứ mười']],['Câu “Con bơi được rồi!” là kiểu câu gì?','Câu cảm',['Câu hỏi','Câu khiến']]]},
+ k4:{theme:'Cổng trường rộng mở',title:'Ngày đầu năm học',text:'Sáng mùng 5 tháng 9, sân trường rực rỡ cờ hoa. Các bạn lớp Một rụt rè nắm tay bố mẹ. Còn chúng em, học sinh lớp Ba, háo hức tìm gặp lại bạn bè sau ba tháng hè.\nTiếng trống khai giảng vang lên “Tùng! Tùng! Tùng!”. Cô hiệu trưởng chúc chúng em một năm học mới chăm ngoan, học giỏi.\nVề lớp, cô giáo chủ nhiệm phát cho mỗi bạn một quyển vở mới thơm mùi giấy. Em nắn nót viết tên mình lên trang đầu tiên.',
+  qs:[['Lễ khai giảng diễn ra vào ngày nào?','Ngày 5 tháng 9',['Ngày 1 tháng 6','Ngày 20 tháng 11']],['Học sinh lớp Một thế nào trong ngày khai giảng?','Rụt rè nắm tay bố mẹ',['Chạy nhảy khắp sân','Đứng phát biểu']],['Cô giáo chủ nhiệm phát cho mỗi bạn thứ gì?','Một quyển vở mới',['Một hộp bút','Một chiếc cặp']],['Từ nào chỉ âm thanh của tiếng trống?','Tùng! Tùng!',['rực rỡ','háo hức']]]},
+ k5:{theme:'Cổng trường rộng mở',title:'Thư viện xanh',text:'Trường em có một thư viện xanh nằm dưới tán cây bàng. Ở đó có những chiếc ghế đá, những giá sách nhỏ sơn màu xanh lá. Giờ ra chơi, các bạn kéo nhau ra đọc truyện, xem sách về khoa học, về các nước trên thế giới.\nCô thủ thư dặn: “Các con đọc xong nhớ để sách đúng chỗ. Muốn mang sách về nhà thì ghi vào phiếu mượn sách nhé!”\nNhờ thư viện xanh, em biết thêm bao điều thú vị: vì sao có cầu vồng, cá voi sống ở đâu, ngọn núi nào cao nhất.',
+  qs:[['Thư viện xanh nằm ở đâu?','Dưới tán cây bàng',['Trên tầng ba','Ở nhà văn hóa']],['Muốn mang sách về nhà, các bạn phải làm gì?','Ghi vào phiếu mượn sách',['Xin phép bố mẹ','Trả tiền cho cô thủ thư']],['Ở thư viện xanh có những loại sách nào?','Truyện, sách khoa học, sách về các nước',['Chỉ có sách giáo khoa','Chỉ có truyện tranh']],['Câu “Các con đọc xong nhớ để sách đúng chỗ.” là câu gì?','Câu khiến',['Câu hỏi','Câu cảm']]]},
+ k6:{theme:'Cổng trường rộng mở',title:'Bạn mới',text:'Đầu năm, lớp em có thêm một bạn mới tên là Hùng. Hùng từ miền núi chuyển về, nói giọng hơi lạ nên bạn ấy rất ngại nói chuyện.\nGiờ ra chơi, Hùng ngồi một mình ở góc lớp. Em đến gần, rủ bạn cùng chơi đá cầu. Hùng đá cầu rất giỏi, chẳng mấy chốc cả nhóm đều reo hò cổ vũ.\nTừ hôm đó, Hùng hay cười hơn. Bạn còn kể cho cả lớp nghe về những ruộng bậc thang và những phiên chợ vùng cao.',
+  qs:[['Vì sao lúc đầu Hùng ngại nói chuyện?','Vì bạn nói giọng hơi lạ',['Vì bạn bị ốm','Vì bạn không thích ai']],['Bạn nhỏ trong bài đã làm gì để giúp Hùng?','Rủ Hùng cùng chơi đá cầu',['Mách cô giáo','Cho Hùng mượn bút']],['Hùng kể cho cả lớp nghe về điều gì?','Ruộng bậc thang và chợ vùng cao',['Biển và đảo xa','Những tòa nhà cao tầng']],['Câu chuyện khuyên chúng ta điều gì?','Quan tâm, giúp đỡ bạn mới',['Không chơi với bạn mới','Chỉ chơi một mình']]]},
+ k7:{theme:'Mái nhà yêu thương',title:'Chiếc khăn len của bà',text:'Mùa đông năm nay, bà đan cho em một chiếc khăn len màu đỏ. Mỗi tối, bà ngồi bên ngọn đèn, đôi tay gầy gầy đưa từng mũi kim thoăn thoắt.\nEm hỏi: “Sao bà không mua khăn cho nhanh ạ?” Bà cười: “Khăn bà đan có cả tình thương của bà trong đó, cháu ạ.”\nSáng nào đi học, em cũng quàng chiếc khăn ấy. Gió lạnh thổi ào ào nhưng cổ em lúc nào cũng ấm áp như có bà ở bên.',
+  qs:[['Bà đan cho em thứ gì?','Một chiếc khăn len màu đỏ',['Một đôi găng tay','Một chiếc áo len xanh']],['Bà đan khăn vào lúc nào?','Mỗi tối, bên ngọn đèn',['Mỗi sáng sớm','Lúc đi chợ']],['Theo bà, khăn bà đan có gì đặc biệt?','Có cả tình thương của bà',['Rất đắt tiền','To hơn khăn ngoài chợ']],['Trong câu “cổ em ấm áp như có bà ở bên”, có hình ảnh gì?','So sánh',['Câu hỏi','Lời nói của nhân vật']]]},
+ k8:{theme:'Mái nhà yêu thương',title:'Em chăm em bé',text:'Mẹ đi làm ca chiều, em ở nhà trông bé Na. Bé Na mới hai tuổi, rất hiếu động. Em đọc truyện tranh, xếp hình cùng bé. Khi bé đòi ăn, em pha một cốc sữa ấm, thổi cho nguội rồi đưa bé uống.\nBé Na ngủ trưa, em khẽ kéo chăn đắp cho bé rồi ngồi học bài bên cạnh. Chiều tối, mẹ về thấy hai chị em ngồi chơi ngoan, mẹ mừng lắm.\nMẹ nói: “Có con, mẹ yên tâm đi làm rồi.”',
+  qs:[['Bé Na bao nhiêu tuổi?','Hai tuổi',['Năm tuổi','Một tuổi']],['Khi bé đòi ăn, chị đã làm gì?','Pha sữa ấm, thổi nguội cho bé uống',['Cho bé ăn kẹo','Gọi điện cho mẹ']],['Khi bé ngủ, chị làm gì?','Đắp chăn cho bé rồi ngồi học bài',['Đi ra ngoài chơi','Xem ti vi thật to']],['Vì sao mẹ yên tâm đi làm?','Vì chị biết chăm em ngoan',['Vì có bà ở nhà','Vì bé Na đi nhà trẻ']]]},
+ k9:{theme:'Mái nhà yêu thương',title:'Ngôi nhà của em',text:'Nhà em nằm cuối con ngõ nhỏ, có mái ngói đỏ tươi. Trước nhà là khoảng sân nhỏ với giàn hoa giấy tím. Phòng khách có bộ bàn ghế gỗ và chiếc tủ đựng sách của bố.\nGóc học tập của em đặt cạnh cửa sổ. Mỗi sáng, ánh nắng chiếu qua ô cửa làm sáng cả bàn học. Tối đến, cả nhà quây quần bên mâm cơm, kể cho nhau nghe chuyện ở trường, ở cơ quan.\nEm yêu ngôi nhà của em vì nơi đó luôn ấm áp tiếng cười.',
+  qs:[['Mái nhà của em màu gì?','Đỏ tươi',['Xanh lam','Vàng nhạt']],['Trước nhà có gì?','Sân nhỏ với giàn hoa giấy tím',['Một ao cá lớn','Một vườn rau xanh']],['Góc học tập của em đặt ở đâu?','Cạnh cửa sổ',['Trong bếp','Ngoài sân']],['Vì sao em yêu ngôi nhà của mình?','Vì nơi đó luôn ấm áp tiếng cười',['Vì nhà rất to','Vì nhà ở gần chợ']]]},
+ k10:{theme:'Mái nhà yêu thương',title:'Ông dạy em đạp xe',text:'Năm em lên tám, ông mua cho em một chiếc xe đạp nhỏ. Chiều nào ông cũng ra ngõ, một tay giữ yên xe, một tay vịn vai em. Ông dặn: “Cháu nhìn thẳng về phía trước, đạp đều chân.”\nLúc đầu em ngã mấy lần, đầu gối trầy xước. Ông xoa dầu cho em và bảo: “Ngã rồi đứng dậy, cháu sẽ đi được.”\nMột hôm, em đạp một mạch hết con ngõ mới biết ông đã buông tay từ lúc nào. Ông đứng phía sau vỗ tay cười rạng rỡ.',
+  qs:[['Ai dạy em đi xe đạp?','Ông',['Bố','Anh trai']],['Ông dặn em điều gì khi đạp xe?','Nhìn thẳng phía trước, đạp đều chân',['Đạp thật nhanh','Nhắm mắt lại']],['Khi em ngã, ông nói gì?','Ngã rồi đứng dậy, cháu sẽ đi được',['Thôi đừng tập nữa','Để bố dạy cháu']],['Từ “rạng rỡ” là từ chỉ gì?','Đặc điểm',['Sự vật','Hoạt động']]]},
+ k11:{theme:'Cộng đồng gắn bó',title:'Bác bảo vệ tốt bụng',text:'Trường em có bác bảo vệ tên là Tư. Sáng nào bác cũng đến sớm mở cổng, quét sạch lá bàng rụng trên sân. Bác nhớ tên gần hết học sinh trong trường.\nCó lần trời mưa to, một bạn lớp Một quên áo mưa. Bác Tư lấy chiếc áo mưa của mình khoác cho bạn rồi che ô đưa bạn ra tận cổng gặp mẹ.\nCuối năm, cả trường tặng bác một tấm thiệp lớn có chữ kí của các bạn. Bác cầm tấm thiệp, mắt rưng rưng.',
+  qs:[['Sáng nào bác Tư cũng làm gì?','Đến sớm mở cổng, quét lá trên sân',['Dạy học sinh hát','Bán quà sáng']],['Trời mưa, bác Tư đã giúp ai?','Một bạn lớp Một quên áo mưa',['Cô hiệu trưởng','Bác lao công']],['Cuối năm, cả trường tặng bác thứ gì?','Một tấm thiệp lớn có chữ kí',['Một bó hoa','Một chiếc ô mới']],['Câu chuyện nói về phẩm chất gì của bác Tư?','Tốt bụng, quan tâm học sinh',['Nghiêm khắc, khó tính','Vui tính, hay đùa']]]},
+ k12:{theme:'Cộng đồng gắn bó',title:'Phiên chợ quê',text:'Sáng chủ nhật, em theo bà đi chợ quê. Chợ họp bên gốc đa đầu làng. Người mua kẻ bán đông vui. Các bà, các mẹ bày bán rau xanh, gà vịt, trứng, cá tôm vừa bắt dưới ao lên.\nBà mua cho em một chiếc bánh đa giòn tan và một con châu chấu tết bằng lá dừa. Ai gặp bà cũng chào hỏi rất thân tình.\nVề nhà, em cứ nhớ mãi tiếng cười nói rộn ràng của phiên chợ quê.',
+  qs:[['Chợ họp ở đâu?','Bên gốc đa đầu làng',['Trong siêu thị','Trên phố lớn']],['Ở chợ có bán những gì?','Rau xanh, gà vịt, trứng, cá tôm',['Ô tô và xe máy','Quần áo và giày dép']],['Bà mua cho em thứ gì?','Bánh đa và châu chấu lá dừa',['Kem và bóng bay','Truyện tranh']],['Cảnh phiên chợ được tả thế nào?','Đông vui, rộn ràng',['Vắng vẻ, im lặng','Buồn tẻ']]]},
+ k13:{theme:'Cộng đồng gắn bó',title:'Những người giữ ánh sáng',text:'Ngoài đảo xa có một ngọn hải đăng. Đêm đêm, ngọn đèn trên đỉnh tháp quay đều, chiếu những luồng sáng xa hàng chục cây số để tàu thuyền đi đúng đường.\nNgười giữ ngọn hải đăng là chú Bình. Chú lau chùi đèn, kiểm tra máy móc mỗi ngày. Có những đêm bão to, sóng gió gào thét, chú vẫn thức trắng để đèn không tắt.\nNhờ những người như chú Bình, các bác ngư dân yên tâm ra khơi đánh cá.',
+  qs:[['Ngọn hải đăng giúp gì cho tàu thuyền?','Chiếu sáng để tàu thuyền đi đúng đường',['Chở hàng ra đảo','Đánh bắt cá']],['Chú Bình làm công việc gì?','Giữ ngọn hải đăng',['Lái tàu biển','Bán cá ở chợ']],['Những đêm bão to, chú Bình làm gì?','Thức trắng để đèn không tắt',['Đi ngủ sớm','Rời đảo về đất liền']],['Câu chuyện giúp em hiểu điều gì?','Công việc thầm lặng giúp ích cho mọi người',['Đảo xa rất vui','Bão biển không nguy hiểm']]]},
+ k14:{theme:'Cộng đồng gắn bó',title:'Bác thợ làm đồ chơi',text:'Đầu phố em có bác Hai làm đồ chơi bằng bột màu. Đôi tay bác thoăn thoắt nặn ra chú gà trống, chú lợn con, nàng tiên cá đủ màu sắc. Bọn trẻ trong phố đứng vây quanh, mắt tròn xoe.\nDạo này, trẻ con thích đồ chơi nhựa nên ít người mua tò he của bác. Bác buồn, định về quê. Biết chuyện, các bạn nhỏ rủ nhau mỗi người mua một con tò he.\nBác Hai cảm động lắm. Bác nói sẽ ở lại, nặn thật nhiều con vật đẹp cho các cháu.',
+  qs:[['Bác Hai làm đồ chơi bằng gì?','Bột màu',['Gỗ','Nhựa']],['Vì sao bác Hai buồn?','Vì ít người mua tò he',['Vì bác bị ốm','Vì bọn trẻ trêu bác']],['Các bạn nhỏ đã làm gì để giúp bác?','Mỗi người mua một con tò he',['Xin bác về quê','Mua đồ chơi nhựa']],['Từ “thoăn thoắt” tả điều gì?','Đôi tay bác làm rất nhanh, khéo',['Bác đi rất chậm','Bác nói rất to']]]}});
