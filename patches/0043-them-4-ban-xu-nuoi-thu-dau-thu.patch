+<!DOCTYPE html>
+<html lang="vi">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
+<script>/* ===== ÂM THANH TRÊN iPAD, iPHONE: vẫn phát tiếng khi máy đang để chế độ im lặng ===== */
+(function(){function set(){try{if(navigator.audioSession&&navigator.audioSession.type!=='playback')navigator.audioSession.type='playback';}catch(e){}}
