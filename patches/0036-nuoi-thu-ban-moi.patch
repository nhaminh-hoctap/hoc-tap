diff --git a/nuoithu.html b/nuoithu.html
new file mode 100644
index 0000000..f87a1a4
--- /dev/null
+++ b/nuoithu.html
@@ -0,0 +1,633 @@
+<!DOCTYPE html>
+<html lang="vi">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
+<title>Nuôi thú</title>
+<style>
+/* ===== Nuôi thú: giao diện ===== */
+#nt{--ink:#1E293B;--mut:#64748B;--line:#E2E8F0;max-width:980px;margin:0 auto;padding:14px max(14px,env(safe-area-inset-left)) 40px;font-family:system-ui,-apple-system,"Segoe UI",sans-serif;color:var(--ink)}
+#nt *{box-sizing:border-box}
+#nt button{font-family:inherit;touch-action:manipulation;cursor:pointer}
+#nt .hide{display:none!important}
+#nt .card{background:#fff;border:2px solid var(--line);border-radius:24px;padding:16px;margin-top:14px;box-shadow:0 4px 0 var(--line)}
+#nt h2{font-size:21px;margin:0 0 10px}
+#nt .mu{color:var(--mut);font-size:15px}
+.nt-top{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);gap:16px;align-items:stretch}
+.nt-scene{position:relative;min-height:330px;border-radius:26px;overflow:hidden;border:3px solid rgba(0,0,0,.08);display:grid;place-items:center;user-select:none;-webkit-user-select:none}
+.nt-scene .pe{position:relative;line-height:1;transition:transform .2s;filter:drop-shadow(0 8px 6px rgba(0,0,0,.18));cursor:pointer}
+.nt-scene .pe.bob{animation:ntBob 2.4s ease-in-out infinite}
+.nt-scene .pe.sad{filter:grayscale(.35) drop-shadow(0 8px 6px rgba(0,0,0,.18))}
+.nt-scene .hat{position:absolute;left:50%;top:-.42em;transform:translateX(-50%);font-size:.42em}
+.nt-scene .toy{position:absolute;bottom:14px;right:18px;font-size:44px}
+.nt-scene .bgi{position:absolute;top:12px;left:16px;font-size:38px;opacity:.9}
+.nt-scene .acc{position:absolute;top:18px;right:20px;font-size:30px}
+.nt-bub{position:absolute;top:14px;left:50%;transform:translateX(-50%);background:#fff;border-radius:18px;padding:8px 14px;font-weight:800;font-size:16px;box-shadow:0 3px 0 rgba(0,0,0,.12);max-width:86%;text-align:center;opacity:0;transition:opacity .25s;pointer-events:none}
+.nt-bub.on{opacity:1}
+.nt-fx{position:absolute;font-size:30px;pointer-events:none;animation:ntUp 1.2s ease-out forwards}
+.nt-fly{position:absolute;font-size:46px;pointer-events:none;transition:all .7s cubic-bezier(.3,.7,.4,1)}
+@keyframes ntBob{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}
+@keyframes ntUp{0%{opacity:1;transform:translateY(0) scale(.8)}100%{opacity:0;transform:translateY(-110px) scale(1.3)}}
+@keyframes ntJump{0%,100%{transform:translateY(0)}30%{transform:translateY(-34px) scale(1.08)}60%{transform:translateY(0) scale(.96)}}
+.nt-info{display:flex;flex-direction:column;gap:10px}
+.nt-name{font-size:24px;font-weight:900}
+.nt-ren{border:none;background:#F1F5F9;border-radius:12px;font-size:18px;min-width:40px;min-height:40px;vertical-align:middle;cursor:pointer}
+.nt-mute{border:2px solid #E2E8F0;background:#fff;border-radius:14px;font-size:22px;min-width:48px;min-height:48px;cursor:pointer}
+.nt-acts .visit{background:#ECFEFF;border-color:#67E8F9;box-shadow:0 4px 0 #67E8F9;grid-column:1/-1}
+.nt-in{display:block;width:100%;box-sizing:border-box;margin:12px 0 8px;font:inherit;font-size:22px;font-weight:800;padding:12px 14px;border:3px solid #C7D2FE;border-radius:16px;text-align:center}
+.nt-sug{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin-bottom:6px}.nt-sug button{font:inherit;font-size:17px;font-weight:800;padding:8px 14px;min-height:44px;border-radius:999px;border:2px solid #FDE68A;background:#FFFBEB;cursor:pointer}
+.nt-cer{position:fixed;inset:0;z-index:9999;background:radial-gradient(circle at 50% 45%,#4338CA,#0F172A 70%);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;color:#fff;text-align:center;padding:20px;overflow:hidden}
+.nt-cer .t{font-size:clamp(24px,4.5vw,36px);font-weight:900;text-shadow:0 3px 0 rgba(0,0,0,.3)}.nt-cer .s{font-size:20px;line-height:1.6}
+.nt-cer .im{width:min(60vw,340px);line-height:0;position:relative}.nt-cer .im img.pic{width:100%!important;height:auto!important;position:relative}
+.nt-cer .im.shk{animation:cShake .12s linear infinite}.nt-cer .im.rev{animation:cRev .9s cubic-bezier(.2,1.6,.4,1)}
+.nt-cer .glow{position:absolute;inset:-25%;background:radial-gradient(circle,rgba(253,224,71,.7),transparent 62%);animation:cGlow 1.4s ease-in-out infinite}
+.nt-cer .flash{position:fixed;inset:0;background:#fff;opacity:0;pointer-events:none}.nt-cer .flash.on{animation:cFlash .8s ease-out}
+.nt-cer button{font:inherit;font-size:21px;font-weight:900;margin-top:12px;padding:14px 30px;border-radius:18px;border:none;background:#FACC15;color:#422006;box-shadow:0 5px 0 #CA8A04;min-height:56px;cursor:pointer}
+.nt-cer .cf{position:fixed;left:50%;top:42%;font-size:34px;pointer-events:none;animation:cConf 1.7s ease-out forwards}.nt-cer .cf img.pic{width:1em;height:1em}
+@keyframes cShake{0%,100%{transform:translate(0,0) rotate(0)}25%{transform:translate(-5px,1px) rotate(-4deg)}50%{transform:translate(4px,-1px) rotate(3deg)}75%{transform:translate(-2px,2px) rotate(-2deg)}}
+@keyframes cRev{0%{transform:scale(.3) rotate(-20deg);opacity:0}60%{transform:scale(1.15) rotate(4deg);opacity:1}100%{transform:scale(1) rotate(0)}}
+@keyframes cGlow{0%,100%{transform:scale(.9);opacity:.7}50%{transform:scale(1.1);opacity:1}}
+@keyframes cFlash{0%{opacity:0}15%{opacity:1}100%{opacity:0}}
+@keyframes cConf{0%{transform:translate(-50%,-50%) scale(.4);opacity:1}100%{transform:translate(calc(-50% + var(--dx)),calc(-50% + var(--dy))) scale(1.2) rotate(var(--r));opacity:0}}
+.nt-pinfo{background:#FEF2F2;border:2px solid #FCA5A5;border-radius:18px;padding:12px 16px;margin:0 0 12px;font-size:17px}.nt-pinfo.ok{background:#F0FDF4;border-color:#86EFAC}
+.nt-xu{flex:none;display:flex;align-items:center;gap:6px;background:#FEF9C3;border:2px solid #FACC15;border-radius:16px;padding:6px 12px;font-size:22px;font-weight:900;box-shadow:0 3px 0 #FACC15}.nt-xu small{font-size:13px;color:#854D0E}
+.nt-lv{font-weight:700;color:var(--mut);font-size:15px}
+.nt-bar{display:grid;grid-template-columns:120px 1fr 44px;align-items:center;gap:8px;font-weight:800;font-size:16px}
+.nt-bar .tr{height:16px;border-radius:99px;background:#F1F5F9;overflow:hidden;border:2px solid var(--line)}
+.nt-bar .tr i{display:block;height:100%;border-radius:99px;transition:width .5s}
+.nt-acts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-top:4px}
+.nt-acts button,.nt-btn{min-height:60px;border-radius:18px;border:2px solid var(--line);background:#fff;font-weight:800;font-size:17px;box-shadow:0 4px 0 var(--line);display:flex;align-items:center;justify-content:center;gap:8px;padding:8px 10px;color:var(--ink)}
+.nt-acts button:active,.nt-btn:active{transform:translateY(3px);box-shadow:0 1px 0 var(--line)}
+.nt-acts button[disabled],.nt-btn[disabled]{opacity:.45}
+.nt-acts .eat{background:#FFF7ED;border-color:#FDBA74;box-shadow:0 4px 0 #FDBA74}
+.nt-acts .sp{background:#FDF2F8;border-color:#F9A8D4;box-shadow:0 4px 0 #F9A8D4}
+.nt-acts .play{background:#EFF6FF;border-color:#93C5FD;box-shadow:0 4px 0 #93C5FD}
+.nt-acts .deco{background:#F5F3FF;border-color:#C4B5FD;box-shadow:0 4px 0 #C4B5FD}
+.nt-acts small{font-weight:700;color:var(--mut);font-size:13px}
